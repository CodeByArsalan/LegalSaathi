# ==========================================
# Legal Saathi - Environment Variables Template
# (Copy this to .env and fill in your real credentials)
# ==========================================

# Database Connection
ConnectionStrings__DefaultConnection="Server=localhost;Database=LegalSaathiDB;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=True;"
DATABASE_URL="Server=localhost;Database=LegalSaathiDB;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=True;"

# JWT Authentication (Minimum 32 characters key)
JwtSettings__SecretKey="YOUR_JWT_SECRET_KEY_HERE_MINIMUM_32_CHARACTERS_LONG_2026!"
JwtSettings__Issuer="https://api.legalsaathi.pk"
JwtSettings__Audience="https://legalsaathi.pk"
JWT_SECRET_KEY="YOUR_JWT_SECRET_KEY_HERE_MINIMUM_32_CHARACTERS_LONG_2026!"

# Email SMTP (Gmail / Custom SMTP)
EmailSettings__Host="smtp.gmail.com"
EmailSettings__Port="587"
EmailSettings__EnableSsl="true"
EmailSettings__Username="your-email@gmail.com"
EmailSettings__Password="your-16-character-app-password"
EMAIL_USERNAME="your-email@gmail.com"
EMAIL_PASSWORD="your-16-character-app-password"

# Free AI Legal Assistant (Groq / OpenRouter)
AiSettings__Provider="Groq"
AiSettings__ApiKey="gsk_your_groq_api_key_here"
AiSettings__ApiUrl="https://api.groq.com/openai/v1/chat/completions"
AiSettings__Model="openai/gpt-oss-120b"
GROQ_API_KEY="gsk_your_groq_api_key_here"

# Next.js Frontend Configuration
NEXT_PUBLIC_API_URL="http://localhost:5000"
