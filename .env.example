# =================================================================
# Legal Saathi - Environment Configuration Template
# NOTE: Copy this file to .env or .env.local for local overrides.
# NEVER commit real credentials, private keys, or API tokens to git.
# =================================================================

# -----------------------------------------------------------------
# 1. Database (Microsoft SQL Server 2022)
# -----------------------------------------------------------------
DB_SERVER=localhost,1433
DB_NAME=LegalSaathiDb
DB_USER=sa
DB_PASSWORD=YourStrong@Passw0rd2026!
DB_CONNECTION_STRING="Server=localhost,1433;Database=LegalSaathiDb;User Id=sa;Password=YourStrong@Passw0rd2026!;TrustServerCertificate=True;MultipleActiveResultSets=True;"

# -----------------------------------------------------------------
# 2. ASP.NET Core API Settings
# -----------------------------------------------------------------
ASPNETCORE_ENVIRONMENT=Development
API_PORT=5000
API_HTTPS_PORT=5001
JWT_SECRET_KEY=LegalSaathi_Super_Secret_Jwt_Signing_Key_Must_Be_At_Least_64_Characters_Long_2026!
JWT_ISSUER=https://api.legalsaathi.pk
JWT_AUDIENCE=https://legalsaathi.pk
JWT_ACCESS_TOKEN_EXPIRATION_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRATION_DAYS=7

# -----------------------------------------------------------------
# 3. Next.js Web Frontend
# -----------------------------------------------------------------
NEXT_PUBLIC_APP_NAME="Legal Saathi"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_API_BASE_URL="http://localhost:5000/api"
NEXT_PUBLIC_DEFAULT_LOCALE="ur"

# -----------------------------------------------------------------
# 4. AI Assistant (OpenAI GPT-4o)
# -----------------------------------------------------------------
# TODO: Add OpenAI production key when ready
OPENAI_API_KEY=sk-placeholder-openai-api-key-here
OPENAI_MODEL=gpt-4o
OPENAI_MAX_TOKENS=2000

# -----------------------------------------------------------------
# 5. Local Payment Gateways (Pakistan)
# -----------------------------------------------------------------
# JazzCash Gateway Credentials
# TODO: Replace with merchant credentials
JAZZCASH_MERCHANT_ID=placeholder_merchant_id
JAZZCASH_PASSWORD=placeholder_password
JAZZCASH_INTEGRITY_SALT=placeholder_integrity_salt
JAZZCASH_RETURN_URL=http://localhost:3000/api/payments/jazzcash-callback

# EasyPaisa Gateway Credentials
# TODO: Replace with store credentials
EASYPAISA_STORE_ID=placeholder_store_id
EASYPAISA_HASH_KEY=placeholder_hash_key
EASYPAISA_RETURN_URL=http://localhost:3000/api/payments/easypaisa-callback

# PayFast / Card Gateway
# TODO: Replace with merchant credentials
PAYFAST_MERCHANT_ID=placeholder_payfast_id
PAYFAST_SECURED_KEY=placeholder_payfast_key

# -----------------------------------------------------------------
# 6. Notifications & OTP (Email / SMS)
# -----------------------------------------------------------------
# SMTP Configuration
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=placeholder_smtp_user
SMTP_PASSWORD=placeholder_smtp_pass
SMTP_FROM_EMAIL=no-reply@legalsaathi.pk
SMTP_FROM_NAME="Legal Saathi Security"

# Pakistan SMS Gateway (e.g. TeleStax / Zong / Telenor API)
# TODO: Add SMS vendor credentials
SMS_GATEWAY_API_KEY=placeholder_sms_key
SMS_GATEWAY_SENDER_ID=LegalSaathi

# -----------------------------------------------------------------
# 7. Document Cloud Storage Vault
# -----------------------------------------------------------------
# Local / Azure Blob / AWS S3
STORAGE_PROVIDER=LocalStorage # LocalStorage | AzureBlob | AwsS3
STORAGE_LOCAL_PATH=./App_Data/EncryptedVault
AZURE_STORAGE_CONNECTION_STRING=placeholder_azure_connection_string
AWS_S3_BUCKET_NAME=placeholder_s3_bucket
